<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- PROFILE BUILDS ARE THE INTERNAL TEST BUILD (small and fast like release, signed with the debug key): like the debug build they may
         talk to the plain-http dev API on this PC's address. Never hand a profile build to the public. RELEASE builds stay on the secure
         default (https only); see tool/build-apks.ps1. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
