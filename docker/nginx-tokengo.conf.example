# TEMPLATE. Not installed anywhere. Save on the server as /etc/nginx/conf.d/tokengo-api.conf ONLY after:
#   1. the API's DNS name points at this server (A record), and
#   2. you have looked at this file, replaced API_DOMAIN, and run `sudo nginx -t`.
# It is a NEW file with its own server_name: it never touches the existing sites' configuration. Reload with `sudo systemctl reload nginx`
# (a reload keeps serving the other sites without dropping connections; if `nginx -t` fails, do not reload).
#
# HTTPS: first install it as the plain-HTTP block below, then run `sudo certbot --nginx -d API_DOMAIN` (certbot is already on the
# server) which adds the 443 block and the redirect to THIS file only.
server {
    listen 80;
    server_name API_DOMAIN;

    client_max_body_size 8m;                  # provider documents / dispute evidence (the API enforces its own 5 MB limit)

    location / {
        proxy_pass http://127.0.0.1:3100;      # the TokenGo API container (loopback only)
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # exactly one hop: the API runs with `trust proxy 1`
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
