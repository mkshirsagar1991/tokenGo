{
  "name": "@tokengo/api",
  "version": "0.0.0",
  "private": true,
  "description": "TokenGo backend — NestJS modular monolith (api + worker entry points)",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.api.js",
    "start:worker": "node --env-file-if-exists=.env dist/main.worker.js",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "depcheck": "depcruise src --config .dependency-cruiser.cjs",
    "migrate:up": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir migrations --database-url-var DATABASE_URL",
    "init-env": "node scripts/init-env.mjs",
    "seed:dev": "node --env-file-if-exists=.env dist/cli/seed-dev.js",
    "razorpay:check": "node --env-file=.env scripts/razorpay-contract-check.cjs",
    "razorpay:webhook-check": "node scripts/razorpay-webhook-check.mjs",
    "admin:create": "node --env-file-if-exists=.env dist/cli/create-admin.js",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern \"unit[.]spec[.]ts$\"",
    "test:int": "jest --runInBand --testPathPattern \"int[.]spec[.]ts$\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.28.17",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "jest": "^29",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29",
    "typescript": "^5",
    "typescript-eslint": "^8.71.1"
  }
}
