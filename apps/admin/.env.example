# TokenGo admin portal. Copy to .env.local (or run `pnpm --filter @tokengo/admin init-env`, which does this for you).
# Base URL of the TokenGo API (server-side only; the browser never talks to it).
API_BASE_URL=http://localhost:3000/api/v1
# REQUIRED in production, at least 32 random characters. Seals the session cookie (AES-256-GCM). Never commit a real value.
SESSION_SECRET=
# Sign the user out after this many minutes without activity (default 15).
SESSION_IDLE_MINUTES=15
# Hard cap on a session's age in hours, whatever the activity (default 12).
SESSION_MAX_HOURS=12
# Set true ONLY behind a reverse proxy/ALB that appends X-Forwarded-For: the client IP is then forwarded to the API for its throttles.
TRUST_PROXY=false
# Extra browser origins allowed on state-changing requests (comma separated), e.g. the public https URL when TLS terminates upstream.
ALLOWED_ORIGINS=
# Defaults to true in production. Set false only to test a production build over plain http on localhost.
COOKIE_SECURE=
