# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000

# Local PostGIS from docker/docker-compose.yml (throwaway local credentials)
DATABASE_URL=postgres://tokengo:tokengo_local_dev_only@localhost:55432/tokengo

# Secrets — in non-local environments these come from AWS Secrets Manager.
# For local dev/test they may be left empty: ephemeral keys are generated at start-up
# (tokens then do not survive a restart). They are REQUIRED when NODE_ENV=production.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# 32 random bytes, base64. Used for AES-256-GCM field encryption.
PII_ENCRYPTION_KEY_B64=
# 32 random bytes, base64. Used for HMAC blind indexes / OTP hashing.
PII_HASH_KEY_B64=

# Login-code (OTP) delivery: "console" prints OTPs to the log in non-production only. Required: a real provider in production.
# Values: console | whatsapp | msg91 | disabled.  For real WhatsApp login set SMS_PROVIDER=whatsapp and fill the block below.
SMS_PROVIDER=console

# --- WhatsApp login codes via the Meta WhatsApp Cloud API (used when SMS_PROVIDER=whatsapp) ---
# The three REQUIRED values (from Meta Business / developers.facebook.com > your app > WhatsApp):
#   WHATSAPP_ACCESS_TOKEN     a permanent System User token (a temporary token expires after ~24 h). A SECRET: keep it out of git.
#   WHATSAPP_PHONE_NUMBER_ID  the numeric "Phone number ID" under API Setup (NOT the phone number itself)
#   WHATSAPP_TEMPLATE_NAME    the NAME of the approved AUTHENTICATION template (WhatsApp Manager > Message templates), e.g. tokengo_auth_otp
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=tokengo_auth_otp
# Optional (defaults shown):
# WHATSAPP_TEMPLATE_LANGUAGE=en_IN            # must equal the language the template was approved in
# WHATSAPP_TEMPLATE_HAS_CODE_BUTTON=true      # true if the template has a "Copy code" button (the code is then sent twice: body + button)
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_BASE_URL=https://graph.facebook.com   # only Meta (or a localhost test double) is accepted
# DEVELOPMENT ONLY: numbers (comma-separated) whose codes go to the API log instead of WhatsApp, e.g. the seeded demo accounts.
# SMS_LOG_ONLY_PHONES=9000000021,9000000022

# Payments. Only a SANDBOX simulator exists — no real money moves. Unset => "sandbox" locally and "disabled" in production;
# an explicit PAYMENT_PROVIDER=sandbox is REFUSED in production (no live provider is approved).
PAYMENT_PROVIDER=sandbox
# 32 random bytes, base64. Signs/verifies provider webhooks (the sandbox signs with it). Random per process if empty.
PAYMENT_WEBHOOK_SECRET_B64=
# --- Razorpay, TEST MODE ONLY. To use it: PAYMENT_PROVIDER=razorpay and fill the three values from Razorpay's dashboard (Test Mode).
# A LIVE key (rzp_live_...) is REFUSED, and razorpay is refused when NODE_ENV=production. In the dashboard: enable AUTO-CAPTURE (an
# 'authorized' payment is never credited here) and add a webhook with the same secret as RAZORPAY_WEBHOOK_SECRET pointing at
#   POST <your public URL>/api/v1/payments/webhooks/razorpay
# for payment.authorized, payment.captured, payment.failed, order.paid, refund.created, refund.processed, refund.failed.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Top-up limits in minor units (paise) and how long a payment request stays open.
TOPUP_MIN_MINOR=1000
TOPUP_MAX_MINOR=5000000
TOPUP_INTENT_TTL_MINUTES=30

# Provider payouts (bank transfers). Only a SANDBOX simulator exists (no real money). Unset => "sandbox" locally, "disabled" in production;
# an explicit PAYOUT_PROVIDER=sandbox is REFUSED in production. Amounts are paise.
PAYOUT_PROVIDER=sandbox
PAYOUT_MIN_MINOR=10000
PAYOUT_MAX_MINOR=10000000
PAYOUT_DELAY_HOURS=24
PAYOUT_ACCOUNT_COOLING_HOURS=24
PAYOUT_MAX_CONSECUTIVE_FAILURES=3

# Hard safety switch: live money movement is disabled until compliance review (docs §K.4).
REAL_MONEY_ENABLED=false
