{
  "name": "tokengo",
  "private": true,
  "version": "0.0.0",
  "description": "TokenGo — multi-vertical service marketplace (Salon first)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "api:dev": "pnpm --filter @tokengo/api start:dev",
    "api:build": "pnpm --filter @tokengo/api build",
    "api:test": "pnpm --filter @tokengo/api test",
    "api:lint": "pnpm --filter @tokengo/api lint",
    "api:init-env": "pnpm --filter @tokengo/api init-env",
    "api:migrate": "pnpm --filter @tokengo/api migrate:up"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=5.0.0 <5.4.1": ">=5.4.1"
    }
  }
}
